# Release signing credentials template.
# Copy this file to android/keystore.properties (it is gitignored) and fill in
# the values for YOUR release keystore. Generate one with:
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore android/app/release.keystore -alias plum-procurement \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to android/app/.
storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=plum-procurement
keyPassword=YOUR_KEY_PASSWORD
